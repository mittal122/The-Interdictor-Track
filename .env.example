# ── NVIDIA NIM AI Integration ────────────────────────────────────────
# Get your API key from https://build.nvidia.com/
NVIDIA_NIM_API_KEY="nvapi-your-key-here"
NVIDIA_NIM_MODEL="meta/llama-3.1-8b-instruct"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ── PostgreSQL Database ──────────────────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_USER=interdictor
PG_PASSWORD=interdictor
PG_DATABASE=interdictor_db

# ── Prometheus Telemetry ─────────────────────────────────────────────
PROMETHEUS_URL=http://localhost:9090

# ── JWT Secret ───────────────────────────────────────────────────────
JWT_SECRET=super-secret-interdictor-key

# ── SSL/TLS (generate via: powershell scripts/generate-certs.ps1) ───
# Certs are auto-detected from certs/cert.pem and certs/key.pem
# For production, replace with real CA-signed certificates.

# ── Cloud Provider Automation (AWS) ──────────────────────────────────
# Required for real-time EC2 sync and Cost Explorer billing data
AWS_ACCESS_KEY_ID="your_aws_access_key"
AWS_SECRET_ACCESS_KEY="your_aws_secret_key"
AWS_REGION="us-east-1"

# ── Alerting (Slack Webhooks) ─────────────────────────────────────────
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/YOUR/WEBHOOK/URL"
