# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ── PostgreSQL Database ──────────────────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_USER=interdictor
PG_PASSWORD=interdictor
PG_DATABASE=interdictor_db

# ── Prometheus Telemetry ─────────────────────────────────────────────
PROMETHEUS_URL=http://localhost:9090

# ── JWT Secret ───────────────────────────────────────────────────────
JWT_SECRET=super-secret-interdictor-key

# ── SSL/TLS (generate via: powershell scripts/generate-certs.ps1) ───
# Certs are auto-detected from certs/cert.pem and certs/key.pem
# For production, replace with real CA-signed certificates.
